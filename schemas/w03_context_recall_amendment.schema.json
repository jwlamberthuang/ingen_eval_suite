{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Week 3 context recall annotation amendment",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotation_version", "review_status", "review_role", "independent_human_assessment", "scope", "base_hashes", "audited_case_ids", "edits", "approval"],
  "properties": {
    "annotation_version": {"const": "2.0.1"},
    "review_status": {"const": "approved"},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_role", "reviewed_on", "reviewed_case_ids", "annotation_content_sha256"],
      "properties": {
        "reviewer_role": {"const": "intern_annotation_review"},
        "reviewed_on": {"type": "string", "format": "date"},
        "reviewed_case_ids": {"$ref": "#/$defs/strings", "minItems": 1},
        "annotation_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "review_role": {"const": "technical-inspection"},
    "independent_human_assessment": {"const": false},
    "scope": {"type": "string", "minLength": 1},
    "base_hashes": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^(configs|data|results)/[A-Za-z0-9_./-]+$", "not": {"pattern": "\\.\\."}},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "audited_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "edits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edit"}}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "text", "equivalence_notes", "context_support", "evidence_passage_ids", "source_ids", "verification_notes"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^f[0-9]{3}$"},
        "text": {"type": "string", "minLength": 1},
        "equivalence_notes": {"type": "string", "minLength": 1},
        "context_support": {"enum": ["supported", "unsupported", "conflicting"]},
        "evidence_passage_ids": {"$ref": "#/$defs/strings"},
        "source_ids": {"$ref": "#/$defs/strings", "minItems": 1},
        "verification_notes": {"type": "string", "minLength": 1}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "requested_information", "canonical_value"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^f[0-9]{3}$"},
        "requested_information": {"type": "string", "minLength": 1},
        "canonical_value": {"type": "null"}
      }
    },
    "edit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "before", "after", "unresolved_answer_slots", "behavior_observations", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "before": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "after": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "unresolved_answer_slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
        "behavior_observations": {"$ref": "#/$defs/strings", "minItems": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
