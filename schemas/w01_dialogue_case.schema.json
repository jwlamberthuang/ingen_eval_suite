{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Week 1 bilingual dialogue case",
  "description": "Record contract version 1.1.0. Cross-reference, family, release, and semantic checks are additionally required.",
  "$comment": "Use a Draft 2020-12 validator with date and URI format assertions enabled. Draft review states are allowed here; collection and release acceptance checks are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "domain", "language", "difficulty", "query", "context", "ideal_response", "evaluation_labels", "construction_notes"],
  "properties": {
    "id": {"$ref": "#/$defs/caseId"},
    "domain": {"enum": ["fari-en", "fari-zh", "senpai-en", "senpai-zh"]},
    "language": {"enum": ["en", "zh"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "query": {"$ref": "#/$defs/text"},
    "context": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "ideal_response": {"$ref": "#/$defs/text"},
    "evaluation_labels": {"$ref": "#/$defs/labels"},
    "construction_notes": {"$ref": "#/$defs/text"},
    "input_metadata": {"$ref": "#/$defs/inputMetadata"}
  },
  "allOf": [
    {"if": {"properties": {"domain": {"const": "fari-en"}}}, "then": {"properties": {"language": {"const": "en"}, "id": {"pattern": "^w01-fari-en-"}}}},
    {"if": {"properties": {"domain": {"const": "fari-zh"}}}, "then": {"properties": {"language": {"const": "zh"}, "id": {"pattern": "^w01-fari-zh-"}}}},
    {"if": {"properties": {"domain": {"const": "senpai-en"}}}, "then": {"properties": {"language": {"const": "en"}, "id": {"pattern": "^w01-senpai-en-"}}}},
    {"if": {"properties": {"domain": {"const": "senpai-zh"}}}, "then": {"properties": {"language": {"const": "zh"}, "id": {"pattern": "^w01-senpai-zh-"}}}},
    {"if": {"properties": {"domain": {"enum": ["senpai-en", "senpai-zh"]}}}, "then": {"required": ["input_metadata"], "properties": {"input_metadata": {"required": ["learner_profile"]}}}},
    {"if": {"properties": {"language": {"const": "en"}}}, "then": {"properties": {"evaluation_labels": {"properties": {"review": {"properties": {"native_zh_author_id": {"type": "null"}, "native_zh_review_status": {"const": "not_applicable"}}}}}}}},
    {"if": {"properties": {"language": {"const": "zh"}}}, "then": {"properties": {"evaluation_labels": {"properties": {"review": {"properties": {"native_zh_review_status": {"enum": ["pending", "approved"]}}, "allOf": [{"if": {"properties": {"status": {"const": "approved"}}}, "then": {"properties": {"native_zh_author_id": {"const": "Jingwei Huang"}, "native_zh_review_status": {"const": "approved"}}}}]}}}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "caseId": {"type": "string", "pattern": "^w01-(fari|senpai)-(en|zh)-[0-9]{4}-(base|v[0-9]{2})$"},
    "behavior": {"enum": ["answer", "partial_answer_with_uncertainty", "clarify", "abstain"]},
    "textArray": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "inputMetadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dialogue_history": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"$ref": "#/$defs/text"}}}},
        "learner_profile": {"type": "object", "additionalProperties": false, "required": ["level", "learning_objective"], "properties": {"level": {"$ref": "#/$defs/text"}, "learning_objective": {"$ref": "#/$defs/text"}}}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "text", "equivalence_notes", "context_support", "evidence_passage_ids", "source_ids", "verification_notes"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^f[0-9]{3}$"},
        "text": {"$ref": "#/$defs/text"},
        "equivalence_notes": {"type": "string"},
        "context_support": {"enum": ["supported", "unsupported", "contradicted", "conflicting"]},
        "evidence_passage_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^p[0-9]{3}$"}},
        "source_ids": {"$ref": "#/$defs/idArray", "minItems": 1},
        "verification_notes": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"context_support": {"const": "unsupported"}}}, "then": {"properties": {"evidence_passage_ids": {"maxItems": 0}}}, "else": {"properties": {"evidence_passage_ids": {"minItems": 1}}}}
      ]
    },
    "passage": {
      "type": "object", "additionalProperties": false,
      "required": ["passage_id", "context_index", "language", "source_ids"],
      "properties": {
        "passage_id": {"type": "string", "pattern": "^p[0-9]{3}$"},
        "context_index": {"type": "integer", "minimum": 0},
        "language": {"enum": ["en", "zh", "mixed"]},
        "source_ids": {"$ref": "#/$defs/idArray", "minItems": 1}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "kind", "title", "url", "accessed_on", "locator", "author_id"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["public_web", "original_scenario"]},
        "title": {"$ref": "#/$defs/text"},
        "url": {"type": ["string", "null"]},
        "accessed_on": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"]},
        "author_id": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "public_web"}}}, "then": {"properties": {"url": {"type": "string", "pattern": "^https://[^\\s]+$", "format": "uri"}, "accessed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "locator": {"$ref": "#/$defs/text"}}}},
        {"if": {"properties": {"kind": {"const": "original_scenario"}}}, "then": {"properties": {"url": {"type": "null"}, "accessed_on": {"type": "null"}, "author_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}}}}
      ]
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "author_id", "reviewer_ids", "difficulty_rule", "native_zh_author_id", "native_zh_review_status", "notes"],
      "properties": {
        "status": {"enum": ["draft", "needs_revision", "approved"]},
        "author_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "reviewer_ids": {"$ref": "#/$defs/idArray"},
        "difficulty_rule": {"enum": ["E1", "M1", "M2", "H1", "H2", "H3"]},
        "native_zh_author_id": {"type": ["string", "null"]},
        "native_zh_review_status": {"enum": ["not_applicable", "pending", "approved"]},
        "notes": {"type": "string"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "approved"}}}, "then": {"properties": {"reviewer_ids": {"minItems": 1}, "notes": {"$ref": "#/$defs/text"}}}}]
    },
    "labels": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "family_id", "record_kind", "base_case_id", "subset", "context_condition", "query_language", "response_language", "answerability", "expected_behavior", "accepted_behaviors", "edge_case_tags", "required_facts", "passages", "sources", "rubric_criteria", "behavior_criteria", "forbidden_claims", "conflict_resolution", "review"],
      "properties": {
        "schema_version": {"const": "1.1.0"},
        "family_id": {"type": "string", "pattern": "^fam-[0-9]{4}$"},
        "record_kind": {"enum": ["base", "context_variant"]},
        "base_case_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/caseId", "pattern": "-base$"}]},
        "subset": {"enum": ["unassigned", "calibration", "held_out"]},
        "context_condition": {"enum": ["full", "partial", "none", "distractor", "conflicting"]},
        "query_language": {"enum": ["en", "zh", "mixed"]},
        "response_language": {"enum": ["en", "zh"]},
        "answerability": {"enum": ["full", "partial", "none", "ambiguous"]},
        "expected_behavior": {"$ref": "#/$defs/behavior"},
        "accepted_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/behavior"}},
        "edge_case_tags": {"type": "array", "uniqueItems": true, "items": {"enum": ["mixed_language", "culturally_specific_zh", "no_relevant_context", "partial_context", "adversarial", "conflicting_context", "out_of_domain"]}},
        "required_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "passages": {"type": "array", "items": {"$ref": "#/$defs/passage"}},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "rubric_criteria": {"type": "array", "uniqueItems": true, "items": {"enum": ["fari_coherence", "fari_emotional_register", "senpai_correctness", "senpai_learner_suitability", "senpai_curriculum_alignment"]}},
        "behavior_criteria": {"$ref": "#/$defs/textArray", "minItems": 1},
        "forbidden_claims": {"$ref": "#/$defs/textArray"},
        "conflict_resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "review": {"$ref": "#/$defs/review"}
      },
      "allOf": [
        {"if": {"properties": {"record_kind": {"const": "base"}}}, "then": {"properties": {"base_case_id": {"type": "null"}}}, "else": {"properties": {"base_case_id": {"$ref": "#/$defs/caseId", "pattern": "-base$"}}}},
        {"if": {"properties": {"context_condition": {"const": "conflicting"}}}, "then": {"properties": {"conflict_resolution": {"$ref": "#/$defs/text"}}}}
      ]
    }
  }
}
